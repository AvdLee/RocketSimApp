---
// The homepage, told in chapters (see "Homepage chapters" in
// CONTENT-AUTHORING.md).
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";

import Notification from "../old/components/Notification.astro";
import MobileDownloadLinkForm from "../old/components/MobileDownloadLinkForm.astro";
import HomeHeader from "../components/home/HomeHeader.astro";
import Hero from "../components/home/Hero.astro";
import Glance from "../components/home/Glance.astro";
import Brands from "../components/home/Brands.astro";
import Chapter from "../components/home/Chapter.astro";
import Reviews from "../components/home/Reviews.astro";
import SplitCta from "../components/home/SplitCta.astro";
import Mentions from "../components/home/Mentions.astro";
import FinalCta from "../components/home/FinalCta.astro";
import Newsletter from "../components/home/Newsletter.astro";
import Credit from "../components/home/extras/Credit.astro";
import Quote from "../components/home/extras/Quote.astro";
import Stat from "../components/home/extras/Stat.astro";
import TeamCta from "../components/home/extras/TeamCta.astro";
import Terminal from "../components/home/extras/Terminal.astro";

const {
  site: { base_url, title: siteTitle },
  metadata: { meta_description },
} = config;

// Order of the glance tiles and the header's chapter menu. Keep it in
// step with the `<Chapter>` lines below; a build test checks they match.
const chapters = [
  "agents",
  "captures",
  "network",
  "testing",
  "design",
  "teams",
];

const seo = {
  title: siteTitle,
  description: meta_description,
  canonical: base_url,
};

const structuredData = {
  type: "static" as const,
  software: {
    description:
      "RocketSim helps iOS developers and AI coding agents test Simulator and physical-device apps with network monitoring, captures, app actions, accessibility tools, and automation.",
  },
  page: {
    name: "RocketSim",
    description: meta_description,
    url: base_url,
    about: [
      "iOS Simulator",
      "URLSession network monitoring",
      "AI coding agents",
      "Simulator screenshots and recordings",
      "Physical iPhone and iPad testing",
      "Physical-device location and time-zone simulation",
      "Deep-link testing",
      "iOS app testing",
    ],
  },
};
---

<Base seo={seo} structuredData={structuredData} header="home">
  <HomeHeader slot="header" chapters={chapters} />
  <Notification />
  <Hero />
  <Glance chapters={chapters} />
  <Brands />
  <Chapter id="agents">
    <Terminal
      slot="aside"
      label="RocketSim CLI commands an agent can run"
      commands={[
        { note: "Check RocketSim is ready", command: "rocketsim doctor" },
        {
          note: "Read the screen as text, not pixels",
          command: "rocketsim elements --agent",
        },
        {
          note: "Tap the Continue button",
          command: 'rocketsim interact tap --label "Continue"',
        },
        {
          note: "Wait until the screen changes",
          command: "rocketsim wait screen-changed",
        },
        { note: "Test on a slow network", command: "rocketsim network set 3g" },
        {
          note: "Record proof for the PR",
          command: "rocketsim video record --touches > demo.mp4",
        },
      ]}
    />
    <Stat
      slot="aside"
      value="~95%"
      label="less of your agent's context than other Simulator-control tools."
      details={[
        { value: "99%+", label: "fewer tokens" },
        { value: "~24%", label: "faster" },
      ]}
      source="Head-to-head benchmark, July 2026. Tokens and context estimated from output size."
    />
  </Chapter>
  <Chapter id="captures" />
  <Reviews />
  <Chapter id="network">
    <Credit>
      Made possible by <a href="https://github.com/kean/Pulse">Pulse</a>, an
      open-source project created by Alex Grebenyuk.
    </Credit>
  </Chapter>
  <SplitCta />
  <Chapter id="testing" />
  <Chapter id="design" />
  <Chapter id="teams">
    <Quote
      quote="RocketSim Team Insights finally gives us visibility into our build times beyond just gut feeling."
      name="Max Godfrey"
      role="iOS Developer at Tilt"
    />
    <TeamCta />
  </Chapter>
  <Mentions />
  <FinalCta />
  <Newsletter />
  <MobileDownloadLinkForm />
</Base>

<script>
  import { initCountUps } from "@/lib/utils/countUp";
  import { initLazyPosters } from "@/lib/utils/lazyVideo";
  import { onPage } from "@/lib/utils/pageLifecycle";
  import { initReveals } from "@/lib/utils/reveal";

  onPage(() => {
    const stops = [initReveals(), initCountUps(), initLazyPosters()];
    return () => stops.forEach((stop) => stop());
  });
</script>
