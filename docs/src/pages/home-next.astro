---
// Preview of the rebuilt homepage (docs/docs/plans/homepage-rebuild.md).
// Unlinked and noindex until it replaces src/pages/index.astro at launch.
import Base from "@/layouts/Base.astro";
import config from "@/config/config.json";

import Notification from "../old/components/Notification.astro";
import MobileDownloadLinkForm from "../old/components/MobileDownloadLinkForm.astro";
import HomeHeader from "../components/home/HomeHeader.astro";
import Hero from "../components/home/Hero.astro";
import Glance from "../components/home/Glance.astro";
import Brands from "../components/home/Brands.astro";
import Chapter from "../components/home/Chapter.astro";
import Reviews from "../components/home/Reviews.astro";
import SplitCta from "../components/home/SplitCta.astro";
import Everyday from "../components/home/Everyday.astro";
import Mentions from "../components/home/Mentions.astro";
import FinalCta from "../components/home/FinalCta.astro";
import Newsletter from "../components/home/Newsletter.astro";
import Credit from "../components/home/extras/Credit.astro";
import Quote from "../components/home/extras/Quote.astro";
import Stat from "../components/home/extras/Stat.astro";
import TeamCta from "../components/home/extras/TeamCta.astro";
import Terminal from "../components/home/extras/Terminal.astro";

const {
  site: { title: siteTitle },
  metadata: { meta_description },
} = config;

// Order of the glance tiles and the header's chapter menu. Keep it in
// step with the `<Chapter>` lines below; a build test checks they match.
const chapters = [
  "agents",
  "captures",
  "network",
  "testing",
  "design",
  "teams",
];

const seo = {
  title: siteTitle,
  description: meta_description,
  robots: { index: false, follow: false },
};
---

<Base seo={seo} header="home">
  <HomeHeader slot="header" chapters={chapters} />
  <Notification />
  <Hero />
  <Glance chapters={chapters} />
  <Brands />
  <Chapter id="agents">
    <Terminal
      slot="aside"
      label="RocketSim CLI commands an agent can run"
      commands={[
        "rocketsim doctor",
        "rocketsim elements --agent",
        'rocketsim interact tap --label "Continue"',
        "rocketsim wait screen-changed",
        "rocketsim network set 3g",
        "rocketsim video record --touches > demo.mp4",
      ]}
    />
    <Stat
      slot="aside"
      value="~95%"
      label="less context than other Simulator-control tools."
      details={[
        { value: "99%+", label: "less command output" },
        { value: "~24%", label: "less command time" },
      ]}
      source="Head-to-head benchmark, July 2026. Context estimated in bytes."
    />
  </Chapter>
  <Chapter id="captures" />
  <Reviews />
  <Chapter id="network">
    <Credit>
      Made possible by <a href="https://github.com/kean/Pulse">Pulse</a>, an
      open-source project created by Alex Grebenyuk.
    </Credit>
  </Chapter>
  <SplitCta />
  <Chapter id="testing" />
  <Chapter id="design" />
  <Chapter id="teams">
    <Quote
      quote="RocketSim Team Insights finally gives us visibility into our build times beyond just gut feeling."
      name="Max Godfrey"
      role="iOS Developer at Tilt"
    />
    <TeamCta />
  </Chapter>
  <Everyday />
  <Mentions />
  <FinalCta />
  <Newsletter />
  <MobileDownloadLinkForm />
</Base>
