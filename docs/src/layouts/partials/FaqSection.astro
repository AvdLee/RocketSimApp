---
import { markdownify } from "@/lib/utils/textConverter";
import Accordion from "@/shortcodes/Accordion";
import type { CollectionEntry } from "astro:content";
import { getEntry } from "astro:content";

type FaqItem = { question: string; answer: string };

// Pages bring their own questions; without any, the shared pricing FAQ shows.
const { items, heading } = Astro.props as {
  items?: FaqItem[];
  heading?: string;
};
const sectionData = (await getEntry(
  "faqSectionCollection",
  "faq",
)) as CollectionEntry<"faqSectionCollection">;
const title = heading ?? sectionData.data.title;
const list = items ?? sectionData.data.list;
---

<section class="section" id="faq_section">
  <div class="container">
    <div class="section-container gap-10">
      <div class="section-intro text-center">
        <h2
          set:html={markdownify(title)}
          class="title hasEmphasize"
          data-aos="fade-up-sm"
          data-aos-delay="0"
        />
      </div>
      <div class="section-content space-y-5">
        {
          list.map((item, index) => (
            <div data-aos="fade-up-sm" data-aos-delay={100 * index}>
              <Accordion client:load title={item.question}>
                <div class="faq-answer" set:html={markdownify(item.answer)} />
              </Accordion>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
