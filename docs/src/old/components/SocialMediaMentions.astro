---
import SectionHeader from "./SectionHeader.astro";
import SenjaWidget from "../../components/SenjaWidget.astro";
---

<style>
  .mentions {
    margin-top: 3rem;
  }
</style>

<section>
  <div data-aos="fade-in">
    <SectionHeader
      title="Join Thousands Of Productive Developers"
      subtitle="See what others say about RocketSim on Social media"
      smallTitle
    />
  </div>
  <div class="deprecated-grid mentions">
    <SenjaWidget widget="mentions" />
  </div>
</section>
