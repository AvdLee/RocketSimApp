---
import { Image } from "astro:assets";

import licenseManagementImage from "../../assets/features/team-manager-license-management.png";
import usersSeatsImage from "../../assets/features/team-manager-users-seats.png";
---

<section class="team-manager" aria-labelledby="team-manager-title">
  <div class="container">
    <div class="team-manager__intro">
      <p>Online Team Manager</p>
      <h2 id="team-manager-title">Insights, seats, and billing in one place</h2>
      <span>
        Browse build evidence, choose the workspaces and schemes that matter,
        and handle access without maintaining another internal dashboard.
      </span>
    </div>

    <div class="team-manager__dashboard">
      <video
        class="js-lazy-video"
        poster="/features/posters/team-insights-dashboard.webp"
        autoplay
        muted
        loop
        playsinline
        controls
        preload="none"
        aria-label="RocketSim for Teams dashboard showing build insights"
      >
        <source
          data-src="/features/team-insights-dashboard.mp4"
          type="video/mp4"
        />
        <a href="https://www.youtube.com/watch?v=1Ie_ia8hZPI">
          Watch the RocketSim Team Build Insights dashboard tour
        </a>
      </video>
      <div class="team-manager__dashboard-copy">
        <p>Build Insights dashboard</p>
        <h3>Keep the decision and its supporting data together</h3>
        <span>
          Filter by workspace and scheme, compare build durations, and review
          recommendations generated from reported local builds.
        </span>
        <a
          href="https://www.youtube.com/watch?v=1Ie_ia8hZPI"
          target="_blank"
          rel="noreferrer"
        >
          Watch the dashboard tour &rarr;
        </a>
      </div>
    </div>

    <div class="team-manager__settings">
      <article>
        <div>
          <p>Access</p>
          <h3>User and seat management</h3>
          <span>
            Invite developers, assign roles, and see how many seats are in use.
          </span>
        </div>
        <Image
          src={usersSeatsImage}
          alt="RocketSim for Teams user settings showing active users, invited users, roles, and seat management"
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 799px) 100vw, 50vw"
          quality={95}
        />
      </article>
      <article>
        <div>
          <p>Subscription</p>
          <h3>License management</h3>
          <span>
            Find the shared license key, review renewal details, and manage
            billing from the same portal.
          </span>
        </div>
        <Image
          src={licenseManagementImage}
          alt="RocketSim for Teams subscription settings showing the license key, expiry date, and used seats"
          widths={[480, 720, 960, 1200]}
          sizes="(max-width: 799px) 100vw, 50vw"
          quality={95}
        />
      </article>
    </div>
  </div>
</section>

<style>
  .team-manager {
    padding: 7rem 0;
    background: #09090a;
  }

  .team-manager__intro {
    max-width: 48rem;
    margin: 0 auto 3.5rem;
    text-align: center;
  }

  .team-manager__intro > p,
  article p,
  .team-manager__dashboard-copy > p {
    margin: 0 0 0.7rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--primary-color);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .team-manager__intro h2 {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.5rem);
    font-weight: 650;
    color: #fff;
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .team-manager__intro span {
    display: block;
    max-width: 40rem;
    margin: 1.2rem auto 0;
    color: var(--text-color);
    line-height: 1.65;
  }

  .team-manager__dashboard {
    display: grid;
    overflow: hidden;
    background: #151517;
    border: 1px solid rgb(255 255 255 / 9%);
    border-radius: 1.5rem;
    box-shadow: 0 2rem 5rem rgb(0 0 0 / 25%);
  }

  video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 72 / 55;
    object-fit: cover;
    background: #111;
  }

  .team-manager__dashboard-copy {
    align-self: center;
    padding: 2.5rem;
  }

  h3 {
    margin: 0;
    font-size: 1.4rem;
    font-weight: 600;
    color: #fff;
    letter-spacing: -0.02em;
  }

  .team-manager__dashboard-copy span,
  article span {
    display: block;
    margin-top: 0.8rem;
    color: var(--text-color);
    line-height: 1.6;
  }

  .team-manager__dashboard-copy a {
    display: inline-block;
    margin-top: 1.3rem;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--primary-color);
  }

  .team-manager__settings {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
  }

  article {
    display: grid;
    gap: 1.5rem;
    padding: 1.5rem;
    overflow: hidden;
    background: #131315;
    border: 1px solid rgb(255 255 255 / 8%);
    border-radius: 1.4rem;
  }

  article :global(img) {
    width: 100%;
    height: auto;
    border-radius: 0.8rem;
    box-shadow: 0 1rem 2.5rem rgb(0 0 0 / 22%);
  }

  @media (min-width: 800px) {
    .team-manager {
      padding-block: 9rem;
    }

    .team-manager__dashboard {
      grid-template-columns: minmax(0, 1.6fr) minmax(18rem, 0.65fr);
    }

    .team-manager__settings {
      grid-template-columns: repeat(2, 1fr);
    }

    article {
      padding: 2rem;
    }
  }
</style>

<script>
  import { initLazyVideos } from "@/lib/utils/lazyVideo";

  document.addEventListener("astro:page-load", initLazyVideos);
</script>
