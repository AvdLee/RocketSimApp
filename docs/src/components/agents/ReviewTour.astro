---
import { Image } from "astro:assets";

import annotated from "@/content/docs/docs/features/agentic-development/flows/flows-tour-annotated.webp";
import comments from "@/content/docs/docs/features/agentic-development/flows/flows-comments-sidebar.webp";

// The flow review page as it ships: two real captures, and what a person can
// do on it.
const shortcuts = [
  ["C", "Comment on an element"],
  ["F", "Fit the board"],
  ["+ / −", "Zoom in and out"],
  ["Arrows", "Pan"],
  ["Esc", "Clear the selection"],
];
---

<div class="flex flex-col gap-4">
  <figure class="m-0 overflow-hidden rounded-xl bg-surface">
    <Image
      src={annotated}
      alt="The flow review page showing four Stock Analyzer screens, with arrows from each tapped element to the next screen"
      widths={[800, 1200, 1600]}
      sizes="(min-width: 1120px) 1080px, 100vw"
      class="h-auto w-full"
    />
  </figure>
  <div class="grid gap-4 lg:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)]">
    <figure class="m-0 overflow-hidden rounded-xl bg-surface">
      <Image
        src={comments}
        alt="The flow review page's Comments sidebar grouping notes by screen, with a Copy prompt button"
        widths={[640, 960, 1280]}
        sizes="(min-width: 1024px) 600px, 100vw"
        class="h-auto w-full"
      />
    </figure>
    <div class="flex flex-col rounded-xl bg-surface p-6">
      <h3 class="text-title-3">Point at it. Prompt with it.</h3>
      <p class="mt-3 text-copy text-muted">
        Hover an element to read its label and identifier. Press C, click what
        looks wrong, and write a note. <strong class="text-text-dark"
          >Copy prompt</strong
        > turns every note into one message for your agent. When an agent is watching,
        skip the copying: each note moves from Queued to Done as it works.
      </p>
      <dl
        class="m-0 mt-auto grid grid-cols-[auto_1fr] items-center gap-x-4 gap-y-2.5 pt-6 text-small"
      >
        {
          shortcuts.map(([key, action]) => (
            <>
              <dt>
                <kbd class="rounded-md border border-line bg-card px-2 py-0.5 font-mono text-caption tracking-normal text-text-soft">
                  {key}
                </kbd>
              </dt>
              <dd class="m-0 text-muted">{action}</dd>
            </>
          ))
        }
      </dl>
    </div>
  </div>
</div>
