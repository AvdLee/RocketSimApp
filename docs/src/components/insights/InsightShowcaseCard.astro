---
type Variant =
  | "prediction"
  | "machine"
  | "rollout"
  | "regression"
  | "versions"
  | "composition"
  | "activity";

interface Props {
  variant: Variant;
  featured?: boolean;
}

const { variant, featured = false } = Astro.props;

const content = {
  prediction: {
    title: "Newest MacBook Pro prediction",
    message:
      "A MacBook Pro with M5 Max is predicted to save 3–5 hours of build runtime per licensed engineer each month.",
    severity: "opportunity",
    date: "Aug 1 – Aug 28",
  },
  machine: {
    title: "Fastest observed machine",
    message:
      "Your project builds fastest on the observed MacBook Pro with M5 Max.",
    severity: "opportunity",
    date: "Aug 1 – Aug 28",
  },
  rollout: {
    title: "Xcode rollout opportunity",
    message:
      "Xcode 26.0 was consistently faster across matched Mac configurations.",
    severity: "opportunity",
    date: "Aug 1 – Aug 28",
  },
  regression: {
    title: "P95 build regression",
    message: "P95 builds were 13 seconds longer than in the previous period.",
    severity: "warning",
    date: "Aug 15 – Aug 28",
  },
  versions: {
    title: "Multiple Xcode versions",
    message:
      "Validate performance, then standardize across the team for consistent outcomes.",
    severity: "warning",
    date: "Aug 1 – Aug 28",
  },
  composition: {
    title: "Clean builds increased",
    message: "Clean builds made up a larger share than in the previous period.",
    severity: "opportunity",
    date: "Aug 15 – Aug 28",
  },
  activity: {
    title: "Build activity dropped",
    message:
      "Build activity fell 24%, primarily because two fewer Macs reported builds.",
    severity: "warning",
    date: "Aug 15 – Aug 28",
  },
} satisfies Record<
  Variant,
  { title: string; message: string; severity: string; date: string }
>;

const insight = content[variant];
---

<article
  class:list={["insight-card", { "insight-card--featured": featured }]}
  data-insight-variant={variant}
  tabindex="0"
>
  <div
    class:list={[
      "insight-card__icon",
      {
        "insight-card__icon--warning": insight.severity === "warning",
        "insight-card__icon--xcode": variant === "versions",
      },
    ]}
    aria-hidden="true"
  >
    {
      variant === "prediction" || variant === "machine" ? (
        <svg viewBox="0 0 24 24">
          <rect x="4" y="5" width="16" height="11" rx="1.5" />
          <path d="M2.5 19h19M9 19l.5-3h5l.5 3" />
        </svg>
      ) : variant === "composition" ? (
        <svg viewBox="0 0 24 24">
          <path d="M19 8a8 8 0 1 0 1 7" />
          <path d="M19 3v5h-5" />
        </svg>
      ) : variant === "activity" ? (
        <svg viewBox="0 0 24 24">
          <circle cx="8" cy="8" r="3" />
          <circle cx="17" cy="9" r="2.5" />
          <path d="M2.5 19c.5-4 2.5-6 5.5-6s5 2 5.5 6M14 14c3.7-.8 6.3 1 7 4.5" />
        </svg>
      ) : variant === "regression" ? (
        <svg viewBox="0 0 24 24">
          <path d="M4 18V6m0 12h16M7 15l4-4 3 2 5-6" />
          <path d="M16 7h3v3" />
        </svg>
      ) : variant === "rollout" ? (
        <svg viewBox="0 0 24 24">
          <path d="M14 5c3-1 5-1 6-1 0 1 0 3-1 6l-5 5-5-5 5-5Z" />
          <path d="m9 10-3 1-2 2 5 1m5 1-1 5 2-2 1-3M7 17l-2 2" />
        </svg>
      ) : (
        <span class="xcode-mark">
          <svg viewBox="0 0 24 24">
            <rect x="3" y="3" width="18" height="18" rx="4" />
            <path d="m8 16 5-9m-7 6h11m-1-5 2 4" />
          </svg>
          <b>!</b>
        </span>
      )
    }
  </div>

  <div class="insight-card__content">
    <header class="insight-card__header">
      <h3>
        {insight.title}
        <span class="insight-card__date">{insight.date}</span>
      </h3>
      {variant !== "versions" && <p>{insight.message}</p>}
    </header>

    {
      variant === "prediction" && (
        <div class="evidence-box prediction">
          <div
            class="prediction__p95"
            role="img"
            aria-label="Current P95 1 minute 40 seconds, predicted P95 1 minute 10 seconds to 1 minute 20 seconds"
          >
            <span>
              <small>Current P95</small>
              <strong>1m 40s</strong>
            </span>
            <span class="prediction__arrow" aria-hidden="true">
              →
            </span>
            <span>
              <small>Predicted P95</small>
              <strong>1m 10s–1m 20s</strong>
            </span>
          </div>
          <p class="prediction__saving">
            <span>Estimated build runtime saved</span>
            <strong>3–5h / licensed engineer / month</strong>
          </p>
        </div>
      )
    }

    {
      variant === "machine" && (
        <div class="insight-table">
          <div class="insight-table__row insight-table__head">
            <>
              <span>Machine</span>
              <span>P95</span>
              <span>Saved / engineer / month</span>
            </>
          </div>
          <div class="insight-table__row">
            <span>
              <>
                <strong>M5 Max</strong>
                <small>482 matched builds</small>
              </>
            </span>
            <>
              <span>38s</span>
              <span class="positive">3h 42m</span>
            </>
          </div>
          <div class="insight-table__row">
            <span>
              <>
                <strong>M3 Max</strong>
                <small>391 matched builds</small>
              </>
            </span>
            <>
              <span>54s</span>
              <span>—</span>
            </>
          </div>
        </div>
      )
    }

    {
      variant === "rollout" && (
        <div class="evidence-box comparison-bars">
          <div>
            <p>
              <>
                <span>Xcode 16.4</span>
                <strong>55s</strong>
              </>
            </p>
            <i>
              <b style="width: 100%" />
            </i>
            <small>300 matched builds across 1 Mac configuration</small>
          </div>
          <div class="is-improved">
            <p>
              <>
                <span>Xcode 26.0</span>
                <strong>
                  38s <em>(−30%)</em>
                </strong>
              </>
            </p>
            <i>
              <b style="width: 69%" />
            </i>
            <small>300 matched builds across 1 Mac configuration</small>
          </div>
        </div>
      )
    }

    {
      variant === "regression" && (
        <div class="insight-table insight-table--trend">
          <div class="insight-table__row insight-table__head">
            <>
              <span>Percentile</span>
              <span>Previous</span>
              <span>Current</span>
              <span>Change</span>
            </>
          </div>
          <div class="insight-table__row">
            <>
              <span>P95</span>
              <span>41s</span>
              <span>54s</span>
              <strong class="destructive">+13s (+29.5%)</strong>
            </>
          </div>
          <div class="insight-table__row">
            <>
              <span>P75</span>
              <span>18s</span>
              <span>24s</span>
              <strong class="destructive">+6s (+33.3%)</strong>
            </>
          </div>
        </div>
      )
    }

    {
      variant === "versions" && (
        <>
          <div class="insight-table insight-table--versions">
            <div class="insight-table__row insight-table__head">
              <>
                <span>Xcode version</span>
                <span>Builds</span>
              </>
            </div>
            <div class="insight-table__row">
              <>
                <span>26.0 (17A324)</span>
                <strong>600</strong>
              </>
            </div>
            <div class="insight-table__row">
              <>
                <span>16.4 (16F6)</span>
                <strong>214</strong>
              </>
            </div>
          </div>
          <p class="insight-card__recommendation">{insight.message}</p>
        </>
      )
    }

    {
      variant === "composition" && (
        <div class="evidence-box composition">
          <div class="composition__main">
            <div
              class="composition__bar"
              role="img"
              aria-label="70 builds: 40 incremental, 20 clean, 10 unclassified"
            >
              <span class="is-incremental" style="width: 57.14%">
                40
              </span>
              <span class="is-clean" style="width: 28.57%">
                20
              </span>
              <span class="is-unclassified" style="width: 14.29%">
                10
              </span>
            </div>
            <p>
              <>
                <strong>70</strong>
                <span>Total builds</span>
              </>
            </p>
          </div>
          <ul>
            <li>
              <>
                <i class="is-incremental" />
                <span>Incremental</span>
                <strong>40</strong>
              </>
            </li>
            <li>
              <>
                <i class="is-clean" />
                <span>Clean</span>
                <strong>20 (+8.5 pts)</strong>
              </>
            </li>
            <li>
              <>
                <i class="is-unclassified" />
                <span>Unclassified</span>
                <strong>10</strong>
              </>
            </li>
          </ul>
        </div>
      )
    }

    {
      variant === "activity" && (
        <div class="insight-table insight-table--activity">
          <div class="insight-table__row insight-table__head">
            <>
              <span>Metric</span>
              <span>Previous</span>
              <span>Current</span>
              <span>Change</span>
            </>
          </div>
          <div class="insight-table__row">
            <>
              <span>Builds</span>
              <span>892</span>
              <span>678</span>
              <strong class="destructive">−214 (−24%)</strong>
            </>
          </div>
          <div class="insight-table__row">
            <>
              <span>Reporting Macs</span>
              <span>12</span>
              <span>10</span>
              <strong class="destructive">−2 (−17%)</strong>
            </>
          </div>
        </div>
      )
    }

    {
      variant === "prediction" && (
        <p class="insight-card__credibility">
          Anonymous benchmarks from 40+ teams · matched workloads
        </p>
      )
    }
    {
      variant === "activity" && (
        <p class="insight-card__credibility">
          Engineering-flow signal — not a productivity score.
        </p>
      )
    }
  </div>
</article>

<style>
  .insight-card {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 1rem;
    width: min(34rem, calc(100vw - 3rem));
    min-height: 22rem;
    padding: 1rem;
    color: #f5f5f7;
    background: #000;
    border: 1px solid #27272a;
    border-radius: 0.5rem;
  }

  .insight-card:focus-visible {
    outline: 0.125rem solid var(--primary-color);
    outline-offset: 0.25rem;
  }

  .insight-card--featured {
    width: 100%;
    min-height: 0;
    background: #000;
    border-color: #27272a;
  }

  .insight-card__content {
    min-width: 0;
  }

  .insight-card__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    color: var(--primary-color);
    background: #222834;
    border: 1px solid #2c374b;
    border-radius: 0.75rem;
  }

  .insight-card__icon svg {
    width: 1.75rem;
    height: 1.75rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
    vector-effect: non-scaling-stroke;
  }

  .xcode-mark {
    position: relative;
    display: block;
    width: 2.5rem;
    height: 2.5rem;
    color: #88cfff;
  }

  .xcode-mark b {
    position: absolute;
    right: -0.125rem;
    bottom: -0.125rem;
    display: grid;
    width: 1.25rem;
    height: 1.25rem;
    place-items: center;
    font-size: 0.8rem;
    color: #fff;
    line-height: 1;
    background: #c82020;
    border: 0.125rem solid #000;
    border-radius: 50%;
  }

  .insight-card__header {
    display: grid;
    gap: 0.375rem;
  }

  h3 {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    color: #fff;
    line-height: 1.35;
  }

  .insight-card__date {
    margin-left: 0.625rem;
    font-size: 0.75rem;
    font-weight: 400;
    color: #8e97a6;
  }

  .insight-card__header p {
    max-width: 48rem;
    margin: 0;
    color: #c0c6d6;
    line-height: 1.5;
  }

  .evidence-box {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
    padding: 1rem;
    background: #111;
    border: 1px solid #27272a;
    border-radius: 0.5rem;
  }

  .prediction__p95 {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 1rem;
  }

  .prediction__p95 span:not(.prediction__arrow) {
    display: grid;
    gap: 0.125rem;
  }

  .prediction__p95 span:last-child {
    text-align: right;
  }

  small {
    display: block;
    font-size: 0.75rem;
    color: #8e97a6;
  }

  .prediction__p95 strong {
    font-size: 1.125rem;
  }

  .prediction__arrow {
    color: #8e97a6;
  }

  .prediction__saving {
    display: grid;
    gap: 0.125rem;
    margin: 0;
    padding-top: 0.75rem;
    border-top: 1px solid #27272a;
  }

  .prediction__saving span {
    font-size: 0.72rem;
    color: #8e97a6;
  }

  .prediction__saving strong {
    font-size: 1rem;
    color: #f5f5f7;
  }

  .insight-table {
    margin-top: 1rem;
    overflow-x: auto;
    font-size: 0.8125rem;
    background: #111;
    border: 1px solid #27272a;
    border-radius: 0.5rem;
  }

  .insight-table__row {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) 0.55fr 0.8fr;
    gap: 0.5rem;
    align-items: center;
    min-width: 18rem;
    padding: 0.625rem 0.75rem;
    border-top: 1px solid #27272a;
  }

  .insight-table__row > :not(:first-child) {
    text-align: right;
  }

  .insight-table__row strong {
    font-weight: 600;
  }

  .insight-table__head {
    font-size: 0.75rem;
    font-weight: 600;
    color: #8e97a6;
    border-top: 0;
  }

  .positive {
    color: #18ab66;
  }

  .insight-table--versions .insight-table__row {
    grid-template-columns: 1fr auto;
  }

  .insight-table--activity .insight-table__row,
  .insight-table--trend .insight-table__row {
    grid-template-columns: minmax(5rem, 1fr) repeat(3, auto);
    min-width: 25rem;
  }

  em {
    font-style: normal;
    color: #18ab66;
  }

  .destructive {
    color: #fb645e;
    white-space: nowrap;
  }

  .comparison-bars {
    display: grid;
    gap: 1rem;
  }

  .comparison-bars > div {
    min-width: 0;
  }

  .comparison-bars p {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
  }

  .comparison-bars i {
    display: block;
    height: 0.5rem;
    margin-top: 0.375rem;
    overflow: hidden;
    background: #000;
    border-radius: 999px;
  }

  .comparison-bars i b {
    display: block;
    height: 100%;
    background: var(--primary-color);
    border-radius: inherit;
  }

  .comparison-bars .is-improved i b {
    background: #18ab66;
  }

  .comparison-bars small {
    margin-top: 0.375rem;
    color: #8e97a6;
  }

  .insight-card__recommendation {
    margin: 0.875rem 0 0;
    font-size: 0.875rem;
    font-weight: 500;
    color: #c0c6d6;
    line-height: 1.5;
  }

  .composition {
    margin-top: 1rem;
  }

  .composition__main {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .composition__bar {
    display: flex;
    flex: 1;
    min-width: 0;
    height: 2rem;
    overflow: hidden;
    border-radius: 0.375rem;
  }

  .composition__bar span {
    display: flex;
    align-items: center;
    justify-content: center;
    min-width: 1.5rem;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
  }

  .composition .is-incremental {
    background: var(--primary-color);
  }

  .composition .is-clean {
    background: #f59e0b;
  }

  .composition .is-unclassified {
    background: #8e97a6;
  }

  .composition__main > p {
    display: grid;
    flex: 0 0 auto;
    margin: 0;
  }

  .composition__main > p strong {
    font-size: 1.125rem;
  }

  .composition__main > p span {
    font-size: 0.6875rem;
    color: #8e97a6;
    text-transform: uppercase;
  }

  .composition ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    padding: 0;
    margin: 0.875rem 0 0;
    list-style: none;
  }

  .composition li {
    display: flex;
    gap: 0.375rem;
    align-items: center;
    font-size: 0.75rem;
    color: #8e97a6;
  }

  .composition li i {
    width: 0.45rem;
    height: 0.45rem;
    border-radius: 50%;
  }

  .composition li strong {
    color: #f5f5f7;
  }

  .insight-card__credibility {
    margin-top: 0.75rem;
    margin-bottom: 0;
    font-size: 0.75rem;
    color: #8e97a6;
    line-height: 1.45;
  }

  @media (min-width: 600px) {
    .insight-card {
      width: 34rem;
    }

    .insight-card--featured {
      width: 100%;
    }
  }

  @media (max-width: 30rem) {
    .insight-card {
      grid-template-columns: minmax(0, 1fr);
    }

    .prediction__p95 {
      grid-template-columns: 1fr;
    }

    .prediction__p95 span:last-child {
      text-align: left;
    }

    .composition__main {
      align-items: stretch;
      flex-direction: column;
    }
  }
</style>
