---
import { Image } from "astro:assets";

import type { HomepageMedia } from "@/lib/homepageItems";

interface Props {
  media: HomepageMedia;
  sizes: string;
  class?: string;
}

// Videos stay on their poster until the presentation's script loads and
// plays them (src/lib/utils/autoplay.ts, CloserLook.astro).
// `sizes` is the width the media can take inside its frame, inset and all,
// not the frame's, so a 2x screen picks the variant that fits the media
// rather than its frame. 2400 covers the widest gallery media (808px at 3x)
// and 1920 the stage media (720px at 2x+); Astro skips widths above the
// source, so nothing larger than the file is decoded as the page scrolls.
const { media, sizes, class: className } = Astro.props;
---

{
  media.type === "image" ? (
    <Image
      src={media.src}
      alt={media.alt}
      quality={90}
      widths={[360, 640, 800, 1200, 1440, 1600, 1920, 2400]}
      sizes={sizes}
      class={className}
    />
  ) : (
    <video
      class={className}
      aria-label={media.alt}
      poster={media.poster}
      preload="none"
      muted
      playsinline
      loop
    >
      {/* The data-src attribute defers the download until the presentation plays the video. */}
      <source data-src={media.src} type="video/mp4" />
    </video>
  )
}
