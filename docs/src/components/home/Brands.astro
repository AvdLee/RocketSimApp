---
import { readFileSync } from "node:fs";
import { join } from "node:path";
import { Image } from "astro:assets";
import { getEntry } from "astro:content";

import appStoreRating from "@/assets/app-store-rating.jpg";
import appStoreFeatured from "@/assets/app-store-featured.jpg";
import { appStoreUrl } from "@/lib/utils/appStoreUrl";
import { svgSize } from "@/lib/utils/svgSize";

import StatValue from "./extras/StatValue.astro";

const brands = await getEntry(
  "trustedBrandsSectionCollection",
  "trusted-brands",
);
if (!brands) {
  throw new Error("Missing src/content/sections/trusted-brands.md.");
}

// The logos are SVGs in public/; their size lets the row reserve its space.
const logos = brands.data.list.map(({ brand, logo }) => ({
  brand,
  logo,
  ...svgSize(readFileSync(join(process.cwd(), "public", logo), "utf8"), logo),
}));

const stats = [
  { value: "80,000+", label: "developers last year" },
  { value: "250+", label: "teams" },
  { value: "Up to 2×", label: "faster, developers report" },
];

// The App Store badges moved here from the hero, which keeps to the pitch.
// They keep the campaign they have on the live homepage.
const badgeHref = appStoreUrl("Landing Page or Form - 8653523");
const badges = [
  {
    image: appStoreRating,
    alt: "4.8 rating on the App Store, five stars",
    placement: "landing-app-store-reviews",
  },
  {
    image: appStoreFeatured,
    alt: "Apple featured RocketSim in Essential Apps for Developers",
    placement: "landing-app-store-featured",
  },
];
---

<section class="border-y border-line py-14" aria-label="Who uses RocketSim">
  <div class="mx-auto max-w-[1120px] px-5" data-reveal>
    <p class="mb-6 text-center text-small text-muted">
      Used by iOS developers at
    </p>
    <ul
      class="flex flex-wrap items-center justify-center gap-x-11 gap-y-6 lg:flex-nowrap lg:justify-between lg:gap-x-5"
    >
      {
        logos.map(({ brand, logo, width, height }) => (
          <li>
            <img
              src={logo}
              alt={brand}
              width={width}
              height={height}
              loading="lazy"
              class="h-6 w-auto opacity-60 brightness-0 invert sm:h-7"
            />
          </li>
        ))
      }
    </ul>
    <ul class="mt-7 flex flex-wrap justify-center gap-9 text-copy text-muted">
      {
        stats.map(({ value, label }) => (
          <li>
            <b class="text-text-dark tabular-nums">
              <StatValue value={value} />
            </b>{" "}
            {label}
          </li>
        ))
      }
    </ul>
    <div class="mt-10 flex flex-wrap justify-center gap-10">
      {
        badges.map(({ image, alt, placement }) => (
          <a
            href={badgeHref}
            class={`plausible-event-name=App+Store+Install plausible-event-surface=landing plausible-event-placement=${placement} plausible-event-format=badge`}
            target="_blank"
            rel="noopener"
          >
            <Image
              src={image}
              alt={alt}
              width={165}
              densities={[1, 2]}
              class="h-[84px] w-auto md:h-[100px]"
            />
          </a>
        ))
      }
    </div>
  </div>
</section>
