---
import { downloadMicrocopy } from "@/lib/homepage";
import { appStoreUrl } from "@/lib/utils/appStoreUrl";

import Button from "./Button.astro";

// The closing call to action. Its download button is a `landing-footer`
// placement of the existing App Store Install event (ANALYTICS.md); other
// pages pass their own placement and campaign.
interface Props {
  // The heading's two lines.
  heading?: [string, string];
  placement?: string;
  campaign?: string;
}

const {
  heading = [
    "Spend less time operating the Simulator.",
    "Spend more time building your app.",
  ],
  placement = "landing-footer",
  campaign = "website-footer",
} = Astro.props;
const downloadHref = appStoreUrl(campaign);
// The second line lights up as it scrolls in (animations.css): a copy in
// the text colour slides in over the muted line, so the line is set twice.
const [firstLine, lightUp] = heading;
---

<section
  class="mx-auto max-w-[1120px] px-5 py-section text-center"
  aria-labelledby="final-cta-title"
>
  <h2 id="final-cta-title" class="text-title-1 text-balance" data-reveal>
    {firstLine}<br />
    <span data-light-up
      >{lightUp}<span aria-hidden="true" data-light-up-lit
        ><span><span>{lightUp}</span></span></span
      ></span
    >
  </h2>
  <div
    class="mt-9 flex flex-wrap justify-center gap-3.5"
    data-reveal
    style="--reveal-order: 1"
  >
    <Button
      href={downloadHref}
      class={`plausible-event-name=App+Store+Install plausible-event-surface=landing plausible-event-placement=${placement} plausible-event-format=button`}
      target="_blank"
      rel="noopener"
    >
      Free download
    </Button>
    <Button variant="secondary" href="/pricing/">View pricing</Button>
  </div>
  <p class="mt-5 text-caption text-muted" data-reveal style="--reveal-order: 1">
    {downloadMicrocopy}
  </p>
</section>
