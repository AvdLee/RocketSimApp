---
import { Image } from "astro:assets";

import appIcon from "@/assets/rocketsim-app-icon.png";
import { appStoreUrl } from "@/lib/utils/appStoreUrl";

// `ct=` is rewritten client-side to the stored first-touch referer, see
// src/lib/utils/storedReferer.ts.
const appStoreHref = appStoreUrl("website-header");
const microcopy = "No signup. Works with Xcode 16+ and Xcode 27's Device Hub.";
---

<!-- The items enter one after another as the page loads, and the hero
     recedes as it scrolls away (src/styles/animations.css).
     The hero fills the window under the sticky header (HomeHeader.astro:
     52px, 4rem from `md` and 82px from `lg`, plus its 1px border), so the
     glance grid always starts just below the fold. The App Store badges sit
     under the grid (Brands.astro). -->
<section
  class="mx-auto flex min-h-[calc(100svh-53px)] max-w-[1120px] flex-col px-5 text-center md:min-h-[calc(100svh-4rem-1px)] lg:min-h-[calc(100svh-83px)]"
  data-recede
>
  <div class="my-auto pt-10 pb-6">
    <Image
      src={appIcon}
      alt=""
      width={96}
      height={96}
      densities={[1, 2]}
      class="mx-auto mb-10 size-24"
      data-hero-item
      style="--hero-order: 0"
    />
    <h1
      class="mb-6 text-small font-semibold text-muted md:text-intro"
      data-hero-item
      style="--hero-order: 1"
    >
      The iOS Simulator companion for developers and AI coding agents
    </h1>
    <p
      class="text-display text-balance text-text-dark"
      data-hero-item
      style="--hero-order: 2"
    >
      The Simulator,<br />supercharged.
    </p>
    <p
      class="mx-auto mt-8 max-w-[36em] text-lead text-balance text-muted"
      data-hero-item
      style="--hero-order: 3"
    >
      RocketSim adds <b>30+ developer tools</b> to Xcode's Simulator, so you and your
      AI coding agent can inspect, test, and capture your app without leaving your
      flow.
    </p>
    <div
      class="mt-12 flex flex-wrap justify-center gap-3.5"
      data-hero-item
      style="--hero-order: 4"
    >
      <a
        id="js-header-app-store-button"
        href={appStoreHref}
        class="plausible-event-name=App+Store+Install plausible-event-surface=landing plausible-event-placement=landing-hero plausible-event-format=button inline-flex rounded-full bg-primary px-5 py-2.5 font-medium text-white no-underline transition-colors hover:bg-primary-hover"
        target="_blank"
        rel="noopener"
      >
        Free download
      </a>
      <a
        href="/for-teams/"
        class="plausible-event-name=CTA:+Homepage+Hero+-+For+Teams inline-flex rounded-full px-5 py-2.5 font-medium text-primary no-underline inset-ring inset-ring-primary transition-colors hover:bg-primary/12"
      >
        For Teams
      </a>
    </div>
    <p
      class="mt-5 text-caption text-muted"
      data-hero-item
      style="--hero-order: 4"
    >
      {microcopy}
    </p>
  </div>
  <a
    href="#glance"
    class="mx-auto mb-6 text-small text-muted no-underline transition-colors hover:text-text-dark"
    data-hero-item
    style="--hero-order: 5"
  >
    What's inside <span aria-hidden="true">↓</span>
  </a>
</section>

<script>
  import { initStoredReferer } from "@/lib/utils/storedReferer";

  document.addEventListener("DOMContentLoaded", initStoredReferer);
</script>
