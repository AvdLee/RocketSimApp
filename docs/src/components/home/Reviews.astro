---
import SenjaWidget from "../SenjaWidget.astro";
---

<section
  class="mx-auto max-w-[1120px] px-5 pt-[120px] pb-2 md:pt-[184px]"
  aria-labelledby="reviews-title"
>
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <h2
      id="reviews-title"
      class="max-w-[16em] text-[clamp(32px,5vw,48px)] leading-[1.08] font-bold tracking-[-0.03em] text-balance"
    >
      Developers can't stop talking about it.
    </h2>
    <p class="text-[17px] text-muted">
      <b class="mr-1 text-[28px] font-bold text-text-dark tabular-nums">4.8</b>
      <span aria-hidden="true">★</span><span class="sr-only">stars</span> on the App
      Store
    </p>
  </div>
  <div class="mt-12">
    <SenjaWidget widget="reviews" />
  </div>
</section>
