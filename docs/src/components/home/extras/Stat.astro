---
import StatValue from "./StatValue.astro";

interface Props {
  value: string;
  label: string;
  // Smaller figures under the main one.
  details?: { value: string; label: string }[];
  source?: string;
}

const { value, label, details = [], source } = Astro.props;
---

<div class="flex flex-1 flex-col justify-end rounded-lg bg-surface p-6">
  <p class="text-figure text-(--chapter)">
    <StatValue value={value} />
  </p>
  <p class="mt-2 text-small text-muted">{label}</p>
  {
    details.length > 0 && (
      <dl class="mt-4 flex gap-6 border-t border-line pt-3.5">
        {details.map((detail) => (
          <div class="flex flex-col-reverse">
            <dt class="text-caption text-muted">{detail.label}</dt>
            <dd class="m-0 text-title-4 text-text-dark tabular-nums">
              <StatValue value={detail.value} />
            </dd>
          </div>
        ))}
      </dl>
    )
  }
  {source && <p class="mt-3 text-caption text-muted">{source}</p>}
</div>
