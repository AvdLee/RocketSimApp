---
interface Props {
  quote: string;
  name: string;
  role: string;
}

const { quote, name, role } = Astro.props;
---

<figure
  class="mt-14 rounded-lg border border-l-3 border-border border-l-(--chapter) bg-card px-6 py-7 md:px-9 md:py-8"
>
  <blockquote
    class="m-0 border-0 p-0 text-[clamp(20px,2.6vw,28px)] leading-[1.3] font-semibold tracking-[-0.02em] text-balance text-text-dark"
  >
    “{quote}”
  </blockquote>
  <figcaption class="mt-3.5 text-[15px] text-muted">
    <b class="mr-1.5 font-semibold text-text-dark">{name}</b>
    {role}
  </figcaption>
</figure>
