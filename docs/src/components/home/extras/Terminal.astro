---
interface Props {
  // What the commands show, for screen readers.
  label: string;
  // `note` is the agent's one-line reasoning shown above its command.
  commands: { note?: string; command: string }[];
}

const { label, commands } = Astro.props;
---

<!-- Stretches to the height of the extras beside it. -->
<figure class="m-0 flex flex-col">
  <figcaption class="sr-only">{label}</figcaption>
  <pre
    class="m-0 flex-1 overflow-hidden rounded-lg bg-surface px-[18px] py-4 font-mono text-caption leading-relaxed tracking-normal whitespace-pre-wrap text-code"><code>{
    commands.map(({ note, command }) => (
      <>{note && <span class="block opacity-60 not-first:mt-2"># {note}</span>}<span class="block pl-[2ch] -indent-[2ch]"><span class="text-(--chapter)" aria-hidden="true">$</span> {command}</span></>
    ))
  }</code></pre>
</figure>
