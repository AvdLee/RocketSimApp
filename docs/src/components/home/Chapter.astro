---
import { getHomepageChapter } from "@/lib/homepage";

import CloserLook from "./presentations/CloserLook.astro";
import Gallery from "./presentations/Gallery.astro";
import Tabs from "./presentations/Tabs.astro";

interface Props {
  id: string;
}

const { id } = Astro.props;
const { name, title, color, presentation, items, links, Content } =
  await getHomepageChapter(id);

// Extras come in as children from the page template: the `aside` slot sits
// beside the tabs stage, and the default slot follows the links. Other
// presentations have no room beside the stage, so they show the aside below.
const aside = Astro.slots.has("aside")
  ? await Astro.slots.render("aside")
  : undefined;
---

<section
  id={id}
  data-chapter
  data-presentation={presentation}
  class="mx-auto max-w-[1120px] px-5 pt-[120px] pb-4 md:pt-[184px] md:pb-8"
  style={`--chapter: var(--color-chapter-${color})`}
>
  <div
    class="grid items-end gap-x-14 gap-y-5 md:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)]"
  >
    <div>
      <p class="mb-3 text-[19px] font-semibold text-(--chapter)">{name}</p>
      <h2
        class="max-w-[14em] text-[clamp(36px,6vw,64px)] leading-[1.04] font-bold tracking-[-0.03em] text-balance"
      >
        {title}
      </h2>
    </div>
    <div
      class="max-w-[32em] text-muted [&_p]:text-[19px] [&_p]:leading-[1.42] [&_strong]:text-text-dark"
    >
      <Content />
    </div>
  </div>

  {
    presentation === "tabs" && (
      <Tabs id={id} label={name} items={items} aside={aside} />
    )
  }
  {presentation === "gallery" && <Gallery id={id} label={name} items={items} />}
  {
    presentation === "closer-look" && (
      <CloserLook id={id} label={name} items={items} />
    )
  }
  {
    presentation !== "tabs" && aside && (
      <div class="mt-5 grid gap-5 md:grid-cols-2">
        <Fragment set:html={aside} />
      </div>
    )
  }

  {
    links.length > 0 && (
      <div class="mt-12 flex flex-wrap gap-[22px]">
        {links.map((link) => (
          <a
            href={link.href}
            class="text-[17px] text-primary no-underline hover:underline"
          >
            {link.label} →
          </a>
        ))}
      </div>
    )
  }

  <slot />
</section>
