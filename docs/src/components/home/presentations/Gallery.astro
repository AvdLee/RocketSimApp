---
import type { HomepageItem } from "@/lib/homepageItems";

import Media from "../Media.astro";
import AutoplayControl from "./AutoplayControl.astro";

interface Props {
  // Chapter ID, used to keep the slide IDs unique on the page.
  id: string;
  // For the carousel's accessible name.
  chapterName: string;
  items: HomepageItem[];
}

const { id, chapterName, items } = Astro.props;
const total = String(items.length).padStart(2, "0");
const arrowButtonClass =
  "grid size-9 flex-none cursor-pointer place-items-center rounded-lg border border-border bg-card text-caption text-text-dark transition-colors hover:border-primary hover:bg-primary/8 disabled:cursor-default disabled:border-border disabled:bg-card disabled:opacity-35";
---

<!-- Full-bleed track; `--edge` lines the first slide up with the chapter text. -->
<div
  data-presentation-root="gallery"
  role="region"
  aria-roledescription="carousel"
  aria-label={`${chapterName} highlights`}
  class="mx-[calc(50%-50vw)] mt-stack [--edge:max(20px,calc((100vw-1080px)/2))]"
>
  <div
    id={`${id}-track`}
    data-gallery-track
    tabindex="0"
    class="flex snap-x snap-mandatory scroll-px-(--edge) gap-5 overflow-x-auto overscroll-x-contain scroll-smooth px-(--edge) [scrollbar-width:none] focus-visible:-outline-offset-2 motion-reduce:scroll-auto"
  >
    {
      items.map((item, index) => (
        <div
          id={`${id}-slide-${index}`}
          role="group"
          aria-roledescription="slide"
          aria-label={`${index + 1} of ${items.length}`}
          data-current={index === 0 ? "" : undefined}
          class="group flex aspect-[4/5] max-w-full shrink-0 basis-[min(880px,84vw)] snap-start flex-col overflow-hidden rounded-lg border border-border bg-card transition-colors duration-500 ease-smooth motion-reduce:transition-none data-current:border-[color-mix(in_srgb,var(--chapter)_45%,var(--color-border))] sm:aspect-[16/11]"
        >
          {/* Neighbouring slides dim their media only, so their captions stay readable. */}
          <div class="min-h-0 flex-1 border-b border-border bg-surface opacity-50 transition-opacity duration-500 ease-smooth group-data-current:opacity-100 motion-reduce:transition-none">
            <Media
              media={item.media}
              sizes="(min-width: 1048px) 880px, 84vw"
              class="size-full object-cover object-top"
            />
          </div>
          <p class="px-4 pt-3.5 pb-4 text-small text-muted sm:px-[22px] sm:pt-[18px] sm:pb-5">
            <b class="mb-0.5 block text-copy text-muted transition-colors duration-500 ease-smooth group-data-current:text-text-dark motion-reduce:transition-none">
              {item.title}
            </b>
            {item.description}
          </p>
        </div>
      ))
    }
  </div>

  <!-- The picker line draws itself and the buttons slide in as the controls
       scroll in (src/styles/animations.css). -->
  <div
    class="mt-[22px] flex items-center gap-2.5 px-(--edge)"
    data-draw-row
    style={`--draw-count: ${items.length}`}
  >
    <span
      class="min-w-[4.5em] font-mono text-caption tracking-normal text-muted tabular-nums"
      aria-hidden="true"
    >
      <b data-gallery-count class="font-normal text-text-dark">01</b> / {total}
    </span>
    <p class="sr-only" aria-live="polite" data-gallery-status></p>
    <div class="mr-auto flex max-w-[420px] flex-1 items-center gap-1.5">
      {
        items.map((item, index) => (
          <button
            type="button"
            data-gallery-picker
            aria-controls={`${id}-slide-${index}`}
            aria-current={index === 0 ? "true" : "false"}
            aria-label={`Show highlight ${index + 1}: ${item.title}`}
            data-draw
            style={`--draw-index: ${index}`}
            class="relative h-[3px] flex-1 cursor-pointer rounded-sm bg-border after:absolute after:inset-x-0 after:-inset-y-2.5 aria-[current=true]:bg-muted"
          >
            {/* Fills up while autoplay shows the slide. */}
            <span
              data-autoplay-fill
              class="absolute inset-0 origin-left scale-x-0 rounded-[inherit] bg-primary"
            />
          </button>
        ))
      }
    </div>
    <button
      type="button"
      data-gallery-prev
      aria-controls={`${id}-track`}
      aria-label="Previous highlight"
      class={arrowButtonClass}
      data-draw-control
      disabled
    >
      ←
    </button>
    <AutoplayControl name={`${chapterName} highlights`} />
    <button
      type="button"
      data-gallery-next
      aria-controls={`${id}-track`}
      aria-label="Next highlight"
      class={arrowButtonClass}
      data-draw-control
    >
      →
    </button>
  </div>
</div>

<script>
  import { createAutoplay } from "@/lib/utils/autoplay";
  import { nearestIndex } from "@/lib/utils/presentationIndex";

  // The pickers and arrows scroll the track to a slide. Swipes, trackpad
  // scrolls and arrow keys on the focused track scroll it natively, and the
  // current slide follows once the track settles. Autoplay moves through the
  // slides and plays the current slide's video; neighbouring slides are on
  // screen too, but their videos stay on their posters.
  function initGalleries() {
    document
      .querySelectorAll<HTMLElement>('[data-presentation-root="gallery"]')
      .forEach((root) => {
        const track = root.querySelector<HTMLElement>("[data-gallery-track]");
        const prev = root.querySelector<HTMLButtonElement>(
          "[data-gallery-prev]",
        );
        const next = root.querySelector<HTMLButtonElement>(
          "[data-gallery-next]",
        );
        const control = root.querySelector<HTMLButtonElement>(
          "[data-autoplay-control]",
        );
        const count = root.querySelector("[data-gallery-count]");
        const status = root.querySelector("[data-gallery-status]");
        const slides = [
          ...root.querySelectorAll<HTMLElement>(
            '[aria-roledescription="slide"]',
          ),
        ];
        const pickers = [
          ...root.querySelectorAll<HTMLButtonElement>("[data-gallery-picker]"),
        ];
        if (!track || !prev || !next || !control || slides.length === 0) {
          return;
        }

        let current = 0;
        // Set while the track scrolls to a picked slide, so the scroll it
        // causes doesn't pick another one.
        let picked: number | undefined;
        let settle: number | undefined;

        const starts = () =>
          slides.map((slide) => slide.offsetLeft - slides[0].offsetLeft);

        // Marks a slide current. Autoplay's own moves aren't announced, so a
        // screen reader isn't interrupted every few seconds.
        const mark = (index: number, announce = true) => {
          current = index;
          slides.forEach((slide, i) =>
            slide.toggleAttribute("data-current", i === index),
          );
          pickers.forEach((picker, i) =>
            picker.setAttribute("aria-current", String(i === index)),
          );
          if (count) count.textContent = String(index + 1).padStart(2, "0");
          if (status && announce) {
            status.textContent = `Highlight ${index + 1} of ${slides.length}: ${slides[index].querySelector("b")?.textContent?.trim() ?? ""}`;
          }
          prev.disabled = index === 0;
          next.disabled = index === slides.length - 1;
        };

        // Where the track scrolls to for a slide; the last slides may stop
        // short of their start.
        const scrollTarget = (index: number) =>
          Math.min(starts()[index], track.scrollWidth - track.clientWidth);

        // Marks a slide current and scrolls the track to it.
        const goTo = (index: number, announce = true) => {
          mark(index, announce);
          const left = scrollTarget(index);
          // Already there: no scroll follows to clear `picked`.
          if (Math.abs(track.scrollLeft - left) < 1) return;
          picked = index;
          track.scrollTo({ left });
        };

        const autoplay = createAutoplay({
          stage: track,
          items: slides.map((slide, i) => ({
            fill:
              pickers[i]?.querySelector<HTMLElement>("[data-autoplay-fill]") ??
              null,
            video: slide.querySelector("video"),
          })),
          control,
          show: (index) => goTo(index, false),
        });
        // The visitor picked a slide with a picker or an arrow.
        const pickSlide = (index: number) => {
          goTo(index);
          autoplay.pick(index);
        };

        pickers.forEach((picker, index) =>
          picker.addEventListener("click", () => pickSlide(index)),
        );
        prev.addEventListener("click", () =>
          pickSlide(Math.max(0, current - 1)),
        );
        next.addEventListener("click", () =>
          pickSlide(Math.min(slides.length - 1, current + 1)),
        );

        track.addEventListener(
          "scroll",
          () => {
            window.clearTimeout(settle);
            settle = window.setTimeout(() => {
              // A picked slide the track reached stays current, even if
              // another slide's start is nearer. A swipe that interrupted the
              // scroll to it picks by position instead.
              const target =
                picked === undefined ? undefined : scrollTarget(picked);
              picked = undefined;
              if (
                target !== undefined &&
                Math.abs(track.scrollLeft - target) < 2
              )
                return;
              const index = nearestIndex(
                starts(),
                track.scrollLeft,
                track.scrollWidth - track.clientWidth,
              );
              if (index !== current) {
                mark(index);
                autoplay.pick(index);
              }
            }, 120);
          },
          { passive: true },
        );
      });
  }

  document.addEventListener("astro:page-load", initGalleries);
</script>
