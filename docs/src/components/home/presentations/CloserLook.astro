---
import type { HomepageItem } from "@/lib/homepageItems";

import Media from "../Media.astro";

interface Props {
  // Chapter ID, used to keep the description IDs unique on the page.
  id: string;
  // Shown in the panel's title bar.
  chapterName: string;
  items: HomepageItem[];
}

const { id, chapterName, items } = Astro.props;
---

<!-- A Mac-style tools window: a list of tools beside a stage. -->
<div
  data-presentation-root="closer-look"
  class="mt-stack grid overflow-hidden rounded-lg border border-border bg-card md:min-h-[560px] md:grid-cols-[minmax(0,260px)_minmax(0,1fr)] md:grid-rows-[auto_1fr] lg:grid-cols-[minmax(0,320px)_minmax(0,1fr)]"
>
  <div
    class="flex h-10 items-center gap-2 border-b border-border bg-surface px-3.5 text-caption text-muted md:col-span-2"
    aria-hidden="true"
  >
    <i class="size-3 rounded-full bg-window-control"></i>
    <i class="size-3 rounded-full bg-window-control"></i>
    <i class="size-3 rounded-full bg-window-control"></i>
    <span class="ml-2.5 font-semibold">{chapterName} tools</span>
  </div>

  <div class="px-2.5 py-3.5 max-md:order-2 md:border-r md:border-border">
    <ul class="flex flex-col gap-0.5">
      {
        items.map((item, index) => (
          <li>
            <button
              type="button"
              aria-expanded={index === 0 ? "true" : "false"}
              aria-controls={`${id}-tool-${index}`}
              class="group flex w-full cursor-pointer items-center gap-2.5 rounded-md px-3 py-[9px] text-left text-small font-medium text-text-soft transition-colors hover:bg-white/5 hover:text-text-dark aria-expanded:bg-primary aria-expanded:text-white"
            >
              <span
                class="w-4 flex-none text-center text-intro leading-none text-muted transition-transform duration-200 ease-smooth group-aria-expanded:rotate-90 group-aria-expanded:text-white motion-reduce:transition-none"
                aria-hidden="true"
              >
                ›
              </span>
              {item.title}
            </button>
            <p
              id={`${id}-tool-${index}`}
              class="animate-disclose pt-2 pr-3 pb-3 pl-[38px] text-small text-muted motion-reduce:animate-none"
              hidden={index !== 0}
            >
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    data-closer-look-stage
    class="relative bg-surface max-md:order-1 max-md:aspect-square max-md:border-b max-md:border-border md:min-h-[360px]"
  >
    {
      items.map((item, index) => (
        <div
          data-closer-look-frame
          class="absolute inset-0 p-4 transition-[opacity,visibility] duration-500 ease-smooth inert:invisible inert:opacity-0 motion-reduce:transition-none md:p-7"
          inert={index !== 0}
        >
          <Media
            media={item.media}
            sizes="(min-width: 1120px) 760px, (min-width: 768px) 70vw, 100vw"
            class="size-full rounded-lg object-contain"
          />
        </div>
      ))
    }
  </div>
</div>

<script>
  import { loadVideo } from "@/lib/utils/lazyVideo";
  import { prefersReducedMotion } from "@/lib/utils/motion";
  import { bindRovingKeys } from "@/lib/utils/rovingFocus";

  // One tool is open at a time: its description shows under its button and
  // its media fades in on the stage. Up and down arrows move between tools.
  // The open tool's video loops while the stage is in view. With reduced
  // motion it waits on its poster, with controls to start it.
  function initCloserLooks() {
    const reducedMotion = prefersReducedMotion();

    document
      .querySelectorAll<HTMLElement>('[data-presentation-root="closer-look"]')
      .forEach((root) => {
        const buttons = [
          ...root.querySelectorAll<HTMLButtonElement>("[aria-expanded]"),
        ];
        const frames = [
          ...root.querySelectorAll<HTMLElement>("[data-closer-look-frame]"),
        ];
        const videos = frames.map((frame) => frame.querySelector("video"));
        const stage = root.querySelector<HTMLElement>(
          "[data-closer-look-stage]",
        );
        let current = 0;
        let inView = false;

        const syncVideos = () => {
          videos.forEach((video, i) => {
            if (!video) return;
            if (i !== current || !inView) {
              video.pause();
              return;
            }
            loadVideo(video);
            if (reducedMotion) {
              video.controls = true;
              return;
            }
            void video.play().catch(() => {
              // The poster stays when playback cannot start.
            });
          });
        };

        const open = (index: number) => {
          current = index;
          buttons.forEach((button, i) => {
            const expanded = i === index;
            button.setAttribute("aria-expanded", String(expanded));
            const description = document.getElementById(
              button.getAttribute("aria-controls") ?? "",
            );
            if (description) description.hidden = !expanded;
            if (frames[i]) frames[i].inert = !expanded;
          });
          syncVideos();
        };

        buttons.forEach((button, index) =>
          button.addEventListener("click", () => open(index)),
        );
        bindRovingKeys(buttons, "vertical", open);

        if (stage) {
          new IntersectionObserver(
            ([entry]) => {
              inView = entry.isIntersecting;
              syncVideos();
            },
            { threshold: 0.25 },
          ).observe(stage);
        }
      });
  }

  document.addEventListener("astro:page-load", initCloserLooks);
</script>
