---
import type { HomepageItem } from "@/lib/homepageItems";

import Media from "../Media.astro";

interface Props {
  // Chapter ID, used to keep the description IDs unique on the page.
  id: string;
  // Shown in the panel's title bar.
  chapterName: string;
  items: HomepageItem[];
}

const { id, chapterName, items } = Astro.props;
---

<!-- A Mac-style tools window: a list of tools beside a stage. -->
<div
  data-presentation-root="closer-look"
  class="mt-16 grid overflow-hidden rounded-lg border border-border bg-card md:min-h-[560px] md:grid-cols-[minmax(0,320px)_minmax(0,1fr)] md:grid-rows-[auto_1fr]"
>
  <div
    class="flex h-10 items-center gap-2 border-b border-border bg-surface px-3.5 text-caption text-muted md:col-span-2"
    aria-hidden="true"
  >
    <i class="size-3 rounded-full bg-window-control"></i>
    <i class="size-3 rounded-full bg-window-control"></i>
    <i class="size-3 rounded-full bg-window-control"></i>
    <span class="ml-2.5 font-semibold">{chapterName} tools</span>
  </div>

  <div class="px-2.5 py-3.5 max-md:order-2 md:border-r md:border-border">
    <ul class="flex flex-col gap-0.5">
      {
        items.map((item, index) => (
          <li>
            <button
              type="button"
              aria-expanded={index === 0 ? "true" : "false"}
              aria-controls={`${id}-tool-${index}`}
              class="group flex w-full cursor-pointer items-center gap-2.5 rounded-md px-3 py-[9px] text-left text-small font-medium text-text-soft transition-colors hover:bg-white/5 hover:text-text-dark aria-expanded:bg-primary aria-expanded:text-white"
            >
              <span
                class="w-4 flex-none text-center text-intro leading-none text-muted group-aria-expanded:rotate-90 group-aria-expanded:text-white"
                aria-hidden="true"
              >
                ›
              </span>
              {item.title}
            </button>
            <p
              id={`${id}-tool-${index}`}
              class="pt-2 pr-3 pb-3 pl-[38px] text-small text-muted"
              hidden={index !== 0}
            >
              {item.description}
            </p>
          </li>
        ))
      }
    </ul>
  </div>

  <div
    class="relative bg-surface max-md:order-1 max-md:aspect-square max-md:border-b max-md:border-border md:min-h-[360px]"
  >
    {
      items.map((item, index) => (
        <div
          data-closer-look-frame
          class="absolute inset-0 p-4 md:p-7"
          hidden={index !== 0}
        >
          <Media
            media={item.media}
            sizes="(min-width: 1120px) 760px, (min-width: 768px) 65vw, 100vw"
            class="size-full rounded-lg object-contain"
          />
        </div>
      ))
    }
  </div>
</div>

<script>
  import { bindRovingKeys } from "@/lib/utils/rovingFocus";

  // One tool is open at a time: its description shows under its button and
  // its media fills the stage. Up and down arrows move between tools.
  function initCloserLooks() {
    document
      .querySelectorAll<HTMLElement>('[data-presentation-root="closer-look"]')
      .forEach((root) => {
        const buttons = [
          ...root.querySelectorAll<HTMLButtonElement>("[aria-expanded]"),
        ];
        const frames = [
          ...root.querySelectorAll<HTMLElement>("[data-closer-look-frame]"),
        ];

        const open = (index: number) => {
          buttons.forEach((button, i) => {
            const expanded = i === index;
            button.setAttribute("aria-expanded", String(expanded));
            const description = document.getElementById(
              button.getAttribute("aria-controls") ?? "",
            );
            if (description) description.hidden = !expanded;
            if (frames[i]) frames[i].hidden = !expanded;
          });
        };

        buttons.forEach((button, index) =>
          button.addEventListener("click", () => open(index)),
        );
        bindRovingKeys(buttons, "vertical", open);
      });
  }

  document.addEventListener("astro:page-load", initCloserLooks);
</script>
