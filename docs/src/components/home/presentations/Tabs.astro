---
import type { HomepageItem } from "@/lib/homepageItems";

import Media from "../Media.astro";
import MediaBackdrop from "../MediaBackdrop.astro";
import AutoplayControl from "./AutoplayControl.astro";

interface Props {
  // Chapter ID, used to keep the tab and panel IDs unique on the page.
  id: string;
  // For the tab list's accessible name.
  chapterName: string;
  items: HomepageItem[];
  // Rendered extras shown with the stage, such as the agents terminal.
  aside?: string;
}

const { id, chapterName, items, aside } = Astro.props;

// No word runs straight into a closing backtick in this template: knip reads
// that as a tagged template and skips everything up to the next backtick,
// which can hide the script's imports from it.
const label = chapterName + " features";
---

<!-- Below lg the tabs run in a row under the stage; from lg they form a
     list beside it, and the aside's extras sit side by side underneath. The
     DOM reads stage, tabs, extras at every width. Autoplay moves through
     the tabs (src/lib/utils/autoplay.ts). -->
<div
  data-presentation-root="tabs"
  class="mt-stack grid grid-cols-[minmax(0,1fr)] gap-5 lg:grid-cols-[minmax(0,17rem)_minmax(0,1fr)] lg:gap-x-10"
>
  <!-- Swiping the stage sideways on a touch screen changes tabs; vertical
       swipes still scroll the page. -->
  <div
    data-tabs-stage
    data-stage
    class="relative aspect-video touch-pan-y overflow-hidden rounded-lg bg-surface lg:col-start-2 lg:row-start-1"
  >
    {/* The media settles from slightly zoomed in as the stage scrolls in. */}
    <div class="absolute inset-0" data-settle>
      {
        items.map((item, index) => (
          <div
            id={`${id}-panel-${index}`}
            role="tabpanel"
            aria-labelledby={`${id}-tab-${index}`}
            tabindex="0"
            class="absolute inset-0 rounded-lg focus-visible:-outline-offset-2 inert:invisible inert:opacity-0"
            inert={index !== 0}
          >
            <MediaBackdrop media={item.media} />
            {/* Moves and blurs as the panels change (the script below). An
                image with a focus zooms in on it while it shows
                (src/styles/animations.css). */}
            <div
              class="absolute inset-0"
              data-panel-media
              data-focus={item.focus ? "" : undefined}
              data-focus-x={item.focus?.x}
              data-focus-y={item.focus?.y}
              data-focus-zoom={item.focus?.zoom}
            >
              <Media
                media={item.media}
                sizes="(min-width: 1120px) 770px, (min-width: 1024px) 70vw, 100vw"
                class:list={[
                  // Contain, never crop: the stage is 16:9, and media of
                  // any other shape letterboxes. 16:9 videos still fill the
                  // stage edge to edge.
                  "relative size-full object-contain",
                  item.media.type === "image" && "p-6",
                ]}
              />
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-5 lg:col-start-1 lg:row-start-1 lg:mt-0">
    <!-- On phones the row scrolls sideways from the screen edge to the
         autoplay control, so the cut-off tab shows there is more. From lg the
         list runs down the stage's height, with the control at its foot. -->
    <div
      class="flex items-start gap-2.5 md:gap-5 lg:h-full lg:flex-col lg:justify-between"
      data-draw-row
      data-tabs-list
      style={`--draw-count: ${items.length}`}
    >
      <div
        role="tablist"
        aria-label={label}
        class="-ml-5 grid min-w-0 flex-1 scroll-px-5 auto-cols-[minmax(104px,1fr)] grid-flow-col overflow-x-auto scroll-smooth pl-5 [scrollbar-width:none] motion-reduce:scroll-auto md:ml-0 md:auto-cols-fr md:overflow-visible md:pl-0 lg:w-full lg:flex-none lg:grid-flow-row"
      >
        {
          items.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${index}`}
              aria-controls={`${id}-panel-${index}`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-labelledby={`${id}-tab-title-${index}`}
              aria-describedby={`${id}-tab-description-${index}`}
              tabindex={index === 0 ? 0 : -1}
              class="group relative flex cursor-pointer flex-col gap-1 pr-2.5 text-left text-muted last:pr-0 md:pr-6 lg:gap-0 lg:py-3 lg:pr-0 lg:pl-5"
            >
              {/* One line runs under the tabs, or down beside them from lg,
                  and fills up in the colour of the chapter as autoplay moves
                  on. */}
              <span
                class="relative -mr-2.5 mb-3.5 block h-0.5 bg-border group-last:mr-0 group-aria-selected:bg-muted md:-mr-6 lg:absolute lg:inset-y-0 lg:left-0 lg:m-0 lg:h-auto lg:w-0.5"
                data-draw
                style={`--draw-index: ${index}`}
              >
                <span
                  data-autoplay-fill
                  class="absolute inset-0 origin-left scale-x-[var(--autoplay-fill,0)] bg-(--chapter) lg:origin-top lg:scale-x-100 lg:scale-y-[var(--autoplay-fill,0)]"
                />
              </span>
              <span
                id={`${id}-tab-title-${index}`}
                class="text-small font-semibold transition-colors duration-300 group-hover:text-text-soft group-aria-selected:text-text-dark md:text-copy lg:text-intro lg:font-semibold"
              >
                {item.title}
              </span>
              {/* The descriptions of the other tabs step back, so the
                  selected tab stands out. In the list from lg, only the
                  selected tab opens to show its description. */}
              <span class="grid transition-[grid-template-rows] duration-500 ease-smooth max-md:sr-only lg:grid-rows-[0fr] lg:group-aria-selected:grid-rows-[1fr] motion-reduce:transition-none">
                <span
                  id={`${id}-tab-description-${index}`}
                  class="overflow-hidden text-small opacity-50 transition-opacity duration-300 group-hover:opacity-100 group-aria-selected:opacity-100 lg:pt-1"
                >
                  {item.description}
                </span>
              </span>
            </button>
          ))
        }
      </div>
      <AutoplayControl name={label} class="-mt-[17px] lg:mt-0" />
    </div>
    {
      items.map((item, index) => (
        <p
          data-tab-caption
          class="mt-3.5 min-h-[2.9em] text-small text-muted md:hidden"
          hidden={index !== 0}
          aria-hidden="true"
        >
          {item.description}
        </p>
      ))
    }
  </div>

  {
    aside && (
      <div
        data-tabs-aside
        class="flex flex-col gap-5 lg:col-span-2 lg:grid lg:grid-cols-2"
      >
        <Fragment set:html={aside} />
      </div>
    )
  }
</div>

<script>
  import { createAutoplay } from "@/lib/utils/autoplay";
  import { containedRect, focusTransform } from "@/lib/utils/focusZoom";
  import { prefersReducedMotion } from "@/lib/utils/motion";
  import { scrollToReveal, swipeTarget } from "@/lib/utils/presentationIndex";
  import { bindRovingKeys } from "@/lib/utils/rovingFocus";

  // How the panels change: the old media slides away and blurs as it fades,
  // and the new media comes into focus from the other side. Going forward,
  // the media moves the way the tabs read: left along the row, and up along
  // the list from lg.
  const SWAP = {
    // How far the media moves, in px.
    distance: 48,
    blur: 12,
    outMs: 450,
    inMs: 750,
  };
  // How far the media follows a finger swiping the stage; it resists past
  // the first and last tab.
  const DRAG = { follow: 0.5, resist: 0.15 };
  // The ID of the panel-change animations, so cancelling them leaves the
  // focus zoom (a CSS transition) alone.
  const SWAP_ID = "tabs-swap";

  // Where the tabs turn from a row under the stage into a list beside it.
  const LIST_LAYOUT = "(min-width: 1024px)";

  const cssEasing = (name: string, fallback: string) =>
    getComputedStyle(document.documentElement).getPropertyValue(name).trim() ||
    fallback;

  // Click or arrow keys select a tab; the selected tab's panel (and, on
  // phones, its caption) shows. Autoplay selects the tabs in turn and plays
  // the videos; videos in other panels never load.
  function initTabs() {
    const reducedMotion = prefersReducedMotion();
    const listLayout = matchMedia(LIST_LAYOUT);
    const ease = {
      smooth: cssEasing("--ease-smooth", "ease-in-out"),
      enter: cssEasing("--ease-enter", "ease-out"),
    };

    document
      .querySelectorAll<HTMLElement>('[data-presentation-root="tabs"]')
      .forEach((root) => {
        const stage = root.querySelector<HTMLElement>("[data-tabs-stage]");
        const tablist = root.querySelector<HTMLElement>('[role="tablist"]');
        const control = root.querySelector<HTMLButtonElement>(
          "[data-autoplay-control]",
        );
        const tabs = [
          ...root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
        ];
        const captions = [
          ...root.querySelectorAll<HTMLElement>("[data-tab-caption]"),
        ];
        const panels = tabs.map((tab) =>
          document.getElementById(tab.getAttribute("aria-controls") ?? ""),
        );
        if (!stage || !tablist || !control) return;

        let current = 0;
        const mediaOf = (index: number) =>
          panels[index]?.querySelector<HTMLElement>("[data-panel-media]") ??
          null;

        // On phones the tab row scrolls sideways; bring the tab into it
        // without scrolling the page.
        const reveal = (tab: HTMLElement) => {
          if (tablist.scrollWidth <= tablist.clientWidth) return;
          const row = tablist.getBoundingClientRect();
          const item = tab.getBoundingClientRect();
          const left = scrollToReveal(
            {
              scrollLeft: tablist.scrollLeft,
              start: row.left,
              end: row.right,
              padding: parseFloat(getComputedStyle(tablist).scrollPaddingLeft),
            },
            { start: item.left, end: item.right },
          );
          if (left !== undefined) tablist.scrollTo({ left });
        };

        const animate = (
          element: Element | null | undefined,
          keyframes: Keyframe[],
          duration: number,
          easing: string,
        ) =>
          element?.animate(keyframes, {
            id: SWAP_ID,
            duration,
            easing,
          });

        const cancelSwaps = (element: Element | null | undefined) =>
          element
            ?.getAnimations()
            .filter((animation) => animation.id === SWAP_ID)
            .forEach((animation) => animation.cancel());

        // Plays the change from one panel to the next. `direction` is 1
        // going forward and -1 going back; `offset` is where a swipe left
        // the old media, which then moves on sideways.
        const swap = (
          from: number,
          to: number,
          direction: number,
          offset: number,
        ) => {
          const panelsMoving = [panels[from], panels[to]];
          const mediaMoving = [mediaOf(from), mediaOf(to)];
          [...panelsMoving, ...mediaMoving].forEach(cancelSwaps);
          if (reducedMotion) return;

          const shift = SWAP.distance * direction;
          const down = listLayout.matches && offset === 0;
          const at = (px: number) => (down ? `0 ${px}px` : `${px}px 0`);
          const blur = `blur(${SWAP.blur}px)`;
          // The old panel is already inert, and so hidden; it stays visible
          // while it fades.
          animate(
            panels[from],
            [
              { opacity: 1, visibility: "visible" },
              { opacity: 0, visibility: "visible" },
            ],
            SWAP.outMs,
            ease.smooth,
          );
          animate(
            mediaOf(from),
            [
              { translate: at(offset), filter: "blur(0)" },
              { translate: at(offset - shift), filter: blur },
            ],
            SWAP.outMs,
            ease.smooth,
          );
          animate(
            panels[to],
            [{ opacity: 0 }, { opacity: 1 }],
            SWAP.inMs,
            ease.enter,
          );
          animate(
            mediaOf(to),
            [
              { translate: at(shift), filter: blur },
              { translate: "0 0", filter: "blur(0)" },
            ],
            SWAP.inMs,
            ease.enter,
          );
        };

        // The caption under the tabs on phones swaps in from the side the
        // media comes from.
        const showCaption = (index: number, direction: number) => {
          captions.forEach((caption, i) => (caption.hidden = i !== index));
          if (reducedMotion) return;
          animate(
            captions[index],
            [
              { opacity: 0, translate: `${12 * direction}px 0` },
              { opacity: 1, translate: "0 0" },
            ],
            SWAP.inMs,
            ease.enter,
          );
        };

        const select = (index: number, direction = 1, offset = 0) => {
          if (index === current) return;
          const previous = current;
          current = index;
          tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute("aria-selected", String(selected));
            tab.tabIndex = selected ? 0 : -1;
            const panel = panels[i];
            if (panel) panel.inert = !selected;
          });
          swap(previous, index, direction, offset);
          showCaption(index, direction);
          reveal(tabs[index]);
        };

        const autoplay = createAutoplay({
          stage,
          items: tabs.map((tab, i) => ({
            fill: tab.querySelector<HTMLElement>("[data-autoplay-fill]"),
            video: panels[i]?.querySelector("video") ?? null,
          })),
          control,
          // Autoplay always moves forward, also from the last tab back to
          // the first.
          show: (index) => select(index, 1),
        });
        // The visitor picked a tab by click, key or swipe.
        const pickTab = (index: number, offset = 0) => {
          select(index, Math.sign(index - current) || 1, offset);
          autoplay.pick(index);
        };

        tabs.forEach((tab, index) =>
          tab.addEventListener("click", () => pickTab(index)),
        );
        // Arrow keys follow the layout: left and right along the row, up and
        // down the list.
        const orientation = () =>
          listLayout.matches ? "vertical" : "horizontal";
        const syncOrientation = () =>
          tablist.setAttribute("aria-orientation", orientation());
        syncOrientation();
        listLayout.addEventListener("change", syncOrientation);
        bindRovingKeys(tabs, orientation, pickTab);

        // Swipes on the stage. The media follows the finger once the swipe
        // is clearly sideways; a vertical one is left to scroll the page.
        let swipe:
          | { id: number; x: number; y: number; axis?: "x" | "y"; dx: number }
          | undefined;

        const settleSwipe = (moved: number) => {
          const media = mediaOf(current);
          if (!media) return;
          media.style.translate = "";
          if (reducedMotion || moved === 0) return;
          animate(
            media,
            [{ translate: `${moved}px 0` }, { translate: "0 0" }],
            SWAP.outMs,
            ease.enter,
          );
        };

        stage.addEventListener("pointerdown", (event) => {
          if (event.pointerType === "mouse" || !event.isPrimary) return;
          swipe = {
            id: event.pointerId,
            x: event.clientX,
            y: event.clientY,
            dx: 0,
          };
        });

        stage.addEventListener("pointermove", (event) => {
          if (!swipe || event.pointerId !== swipe.id) return;
          const dx = event.clientX - swipe.x;
          const dy = event.clientY - swipe.y;
          if (!swipe.axis) {
            if (Math.hypot(dx, dy) < 10) return;
            swipe.axis = Math.abs(dx) > Math.abs(dy) ? "x" : "y";
          }
          if (swipe.axis !== "x") return;
          swipe.dx = dx;
          const pastEnd =
            swipeTarget(dx < 0 ? -Infinity : Infinity, current, tabs.length) ===
            undefined;
          const media = mediaOf(current);
          if (media && !reducedMotion) {
            const follow = pastEnd ? DRAG.resist : DRAG.follow;
            media.style.translate = `${dx * follow}px 0`;
          }
        });

        const endSwipe = (event: PointerEvent) => {
          if (!swipe || event.pointerId !== swipe.id) return;
          const { axis, dx } = swipe;
          swipe = undefined;
          if (axis !== "x") return;
          const media = mediaOf(current);
          const moved = parseFloat(media?.style.translate || "0") || 0;
          const target =
            event.type === "pointerup"
              ? swipeTarget(dx, current, tabs.length)
              : undefined;
          if (target === undefined) {
            settleSwipe(moved);
            return;
          }
          if (media) media.style.translate = "";
          pickTab(target, moved);
        };
        stage.addEventListener("pointerup", endSwipe);
        stage.addEventListener("pointercancel", endSwipe);

        // Each image with a focus zooms in on it as its panel shows; the
        // size of the stage sets how far it moves.
        const fitFocus = () => {
          root
            .querySelectorAll<HTMLElement>("[data-focus]")
            .forEach((frame) => {
              const image = frame.querySelector("img");
              if (!image) return;
              const style = getComputedStyle(image);
              const padding = (side: string) =>
                parseFloat(style.getPropertyValue(`padding-${side}`)) || 0;
              const width = frame.clientWidth;
              const height = frame.clientHeight;
              const aspect =
                (image.naturalWidth || Number(image.getAttribute("width"))) /
                (image.naturalHeight || Number(image.getAttribute("height")));
              if (!width || !height || !aspect) return;

              const media = containedRect(
                {
                  left: padding("left"),
                  top: padding("top"),
                  width: width - padding("left") - padding("right"),
                  height: height - padding("top") - padding("bottom"),
                },
                aspect,
              );
              const { x, y, scale } = focusTransform({ width, height }, media, {
                x: Number(frame.dataset.focusX),
                y: Number(frame.dataset.focusY),
                zoom: Number(frame.dataset.focusZoom),
              });
              frame.style.setProperty("--focus-x", `${x}px`);
              frame.style.setProperty("--focus-y", `${y}px`);
              frame.style.setProperty("--focus-scale", String(scale));
            });
        };
        new ResizeObserver(fitFocus).observe(stage);
      });
  }

  document.addEventListener("astro:page-load", initTabs);
</script>
