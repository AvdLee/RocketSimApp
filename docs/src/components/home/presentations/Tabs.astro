---
import type { HomepageItem } from "@/lib/homepageItems";

import Media from "../Media.astro";
import AutoplayControl from "./AutoplayControl.astro";

interface Props {
  // Chapter ID, used to keep the tab and panel IDs unique on the page.
  id: string;
  // For the tab list's accessible name.
  chapterName: string;
  items: HomepageItem[];
  // Rendered extras shown beside the stage, such as the agents terminal.
  aside?: string;
}

const { id, chapterName, items, aside } = Astro.props;
---

<!-- The aside sits beside the stage from lg, and after the tabs below it,
     so the DOM reads stage, tabs, extras at every width. Autoplay moves
     through the tabs (src/lib/utils/autoplay.ts). -->
<div
  data-presentation-root="tabs"
  class:list={[
    "mt-stack grid grid-cols-[minmax(0,1fr)] gap-5",
    aside && "lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)]",
  ]}
>
  <div
    data-tabs-stage
    class:list={[
      "relative aspect-video overflow-hidden rounded-lg bg-surface",
      aside && "lg:aspect-auto",
    ]}
  >
    {
      items.map((item, index) => (
        <div
          id={`${id}-panel-${index}`}
          role="tabpanel"
          aria-labelledby={`${id}-tab-${index}`}
          tabindex="0"
          class="absolute inset-0 rounded-lg transition-[opacity,visibility] duration-500 ease-smooth focus-visible:-outline-offset-2 inert:invisible inert:opacity-0 motion-reduce:transition-none"
          inert={index !== 0}
        >
          <Media
            media={item.media}
            sizes={
              aside
                ? "(min-width: 1120px) 660px, (min-width: 1024px) 60vw, 100vw"
                : "(min-width: 1120px) 1080px, 100vw"
            }
            class:list={[
              "size-full",
              item.media.type === "image"
                ? "object-contain p-6"
                : "object-cover",
            ]}
          />
        </div>
      ))
    }
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 h-2/5 bg-[radial-gradient(60%_100%_at_50%_100%,color-mix(in_srgb,var(--chapter)_22%,transparent),transparent)]"
    >
    </div>
  </div>

  <div class:list={["mt-5", aside && "lg:col-span-2"]}>
    <!-- On phones the row scrolls sideways from the screen edge to the
         autoplay control, so the cut-off tab shows there is more. -->
    <div class="flex items-start gap-2.5 md:gap-5">
      <div
        role="tablist"
        aria-label={`${chapterName} features`}
        class="-ml-5 grid min-w-0 flex-1 scroll-px-5 auto-cols-[minmax(104px,1fr)] grid-flow-col overflow-x-auto scroll-smooth pl-5 [scrollbar-width:none] motion-reduce:scroll-auto md:ml-0 md:auto-cols-fr md:overflow-visible md:pl-0"
      >
        {
          items.map((item, index) => (
            <button
              type="button"
              role="tab"
              id={`${id}-tab-${index}`}
              aria-controls={`${id}-panel-${index}`}
              aria-selected={index === 0 ? "true" : "false"}
              aria-labelledby={`${id}-tab-${index}-title`}
              aria-describedby={`${id}-tab-${index}-description`}
              tabindex={index === 0 ? 0 : -1}
              class="group relative flex cursor-pointer flex-col gap-1 pr-2.5 text-left text-muted last:pr-0 md:pr-6"
            >
              {/* One line runs under the tabs and fills up as autoplay moves on. */}
              <span class="relative -mr-2.5 mb-3.5 block h-0.5 bg-border group-last:mr-0 group-aria-selected:bg-muted md:-mr-6">
                <span
                  data-autoplay-fill
                  class="absolute inset-0 origin-left scale-x-0 bg-primary"
                />
              </span>
              <span
                id={`${id}-tab-${index}-title`}
                class="text-small font-semibold transition-colors group-hover:text-text-dark group-aria-selected:text-text-dark md:text-copy"
              >
                {item.title}
              </span>
              <span
                id={`${id}-tab-${index}-description`}
                class="text-small max-md:sr-only"
              >
                {item.description}
              </span>
            </button>
          ))
        }
      </div>
      <AutoplayControl name={`${chapterName} features`} class="-mt-[17px]" />
    </div>
    {
      items.map((item, index) => (
        <p
          data-tab-caption
          class="mt-3.5 min-h-[2.9em] text-small text-muted md:hidden"
          hidden={index !== 0}
          aria-hidden="true"
        >
          {item.description}
        </p>
      ))
    }
  </div>

  {
    aside && (
      <div
        data-tabs-aside
        class="flex flex-col gap-5 lg:col-start-2 lg:row-start-1"
      >
        <Fragment set:html={aside} />
      </div>
    )
  }
</div>

<script>
  import { createAutoplay } from "@/lib/utils/autoplay";
  import { scrollToReveal } from "@/lib/utils/presentationIndex";
  import { bindRovingKeys } from "@/lib/utils/rovingFocus";

  // Click or arrow keys select a tab; the selected tab's panel (and, on
  // phones, its caption) shows. Autoplay selects the tabs in turn and plays
  // the videos; videos in other panels never load.
  function initTabs() {
    document
      .querySelectorAll<HTMLElement>('[data-presentation-root="tabs"]')
      .forEach((root) => {
        const stage = root.querySelector<HTMLElement>("[data-tabs-stage]");
        const tablist = root.querySelector<HTMLElement>('[role="tablist"]');
        const control = root.querySelector<HTMLButtonElement>(
          "[data-autoplay-control]",
        );
        const tabs = [
          ...root.querySelectorAll<HTMLButtonElement>('[role="tab"]'),
        ];
        const captions = [
          ...root.querySelectorAll<HTMLElement>("[data-tab-caption]"),
        ];
        const panels = tabs.map((tab) =>
          document.getElementById(tab.getAttribute("aria-controls") ?? ""),
        );
        if (!stage || !tablist || !control) return;

        // On phones the tab row scrolls sideways; bring the tab into it
        // without scrolling the page.
        const reveal = (tab: HTMLElement) => {
          if (tablist.scrollWidth <= tablist.clientWidth) return;
          const row = tablist.getBoundingClientRect();
          const item = tab.getBoundingClientRect();
          const left = scrollToReveal(
            {
              scrollLeft: tablist.scrollLeft,
              start: row.left,
              end: row.right,
              padding: parseFloat(getComputedStyle(tablist).scrollPaddingLeft),
            },
            { start: item.left, end: item.right },
          );
          if (left !== undefined) tablist.scrollTo({ left });
        };

        const select = (index: number) => {
          tabs.forEach((tab, i) => {
            const selected = i === index;
            tab.setAttribute("aria-selected", String(selected));
            tab.tabIndex = selected ? 0 : -1;
            const panel = panels[i];
            if (panel) panel.inert = !selected;
            if (captions[i]) captions[i].hidden = !selected;
          });
          reveal(tabs[index]);
        };

        const autoplay = createAutoplay({
          stage,
          items: tabs.map((tab, i) => ({
            fill: tab.querySelector<HTMLElement>("[data-autoplay-fill]"),
            video: panels[i]?.querySelector("video") ?? null,
          })),
          control,
          show: select,
        });
        // The visitor picked a tab by click or key.
        const pickTab = (index: number) => {
          select(index);
          autoplay.pick(index);
        };

        tabs.forEach((tab, index) =>
          tab.addEventListener("click", () => pickTab(index)),
        );
        bindRovingKeys(tabs, "horizontal", pickTab);
      });
  }

  document.addEventListener("astro:page-load", initTabs);
</script>
