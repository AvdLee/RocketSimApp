---
import { getCollection } from "astro:content";

import { getHomepageChapterSummary } from "@/lib/homepage";

import ArrowLink from "./ArrowLink.astro";

// Every tool, grouped under the chapter it belongs to, so the page ends on
// the breadth the chapters only sample. Each tool links to its feature page
// (`src/collections/feature-page`); the heading counts the list.
const groups: { chapter: string; tools: [name: string, page: string][] }[] = [
  {
    chapter: "agents",
    tools: [
      ["CLI & Agent Skill", "agentic-development"],
      ["Live browser preview", "agentic-development"],
    ],
  },
  {
    chapter: "captures",
    tools: [
      ["Screenshots", "screenshots-recordings"],
      ["Screen recordings", "screenshots-recordings"],
      ["120 FPS recording", "screenshots-recordings"],
      ["Touch indicators", "screenshots-recordings"],
      ["Bezels & backgrounds", "screenshots-recordings"],
      ["Post Editor", "screenshots-recordings"],
      ["Floating captures", "screenshots-recordings"],
      ["Drag & drop export", "screenshots-recordings"],
      ["Status bar at 09:41", "status-bar"],
    ],
  },
  {
    chapter: "network",
    tools: [
      ["Network Monitor", "networking"],
      ["Copy as cURL", "networking"],
      ["Network speed control", "networking"],
      ["Airplane mode", "networking"],
      ["AI-ready prompts", "networking"],
    ],
  },
  {
    chapter: "testing",
    tools: [
      ["Physical devices", "physical-devices"],
      ["Quick Actions", "app-actions"],
      ["Recent builds", "app-actions"],
      ["Locations & routes", "app-actions"],
      ["Locale & time zone", "app-actions"],
      ["Push notifications", "app-actions"],
      ["Deep links", "app-actions"],
      ["Privacy permissions", "app-actions"],
      ["App folders", "app-actions"],
      ["Reset Keychain", "app-actions"],
      ["User Defaults Editor", "user-defaults-editor"],
      ["Simulator camera", "simulator-camera"],
    ],
  },
  {
    chapter: "design",
    tools: [
      ["Design comparison", "design-comparison"],
      ["Grids", "design-comparison"],
      ["Rulers", "design-comparison"],
      ["Magnifier", "design-comparison"],
      ["Color picker", "design-comparison"],
      ["Slow animations", "design-comparison"],
      ["VoiceOver Navigator", "accessibility"],
      ["Accessibility audit", "accessibility"],
      ["Dynamic Type", "accessibility"],
      ["Environment overrides", "accessibility"],
    ],
  },
  {
    chapter: "teams",
    tools: [
      ["Build Insights", "build-insights"],
      ["Team dashboard", "build-insights"],
      ["Machine comparison", "build-insights"],
    ],
  },
];

const pages = new Set(
  (await getCollection("feature-page"))
    .filter((page) => !page.data.draft)
    .map((page) => page.id),
);
for (const [name, page] of groups.flatMap(({ tools }) => tools)) {
  if (!pages.has(page)) {
    throw new Error(
      `Homepage tool "${name}" links to /features/${page}/, which isn't a published feature page.`,
    );
  }
}

const sections = await Promise.all(
  groups.map(async ({ chapter, tools }) => ({
    ...(await getHomepageChapterSummary(chapter)),
    tools,
  })),
);
const count = groups.reduce((total, { tools }) => total + tools.length, 0);
---

<section
  class="mx-auto max-w-[1120px] px-5 pt-section pb-10"
  aria-labelledby="everyday-title"
>
  <div data-reveal>
    <h2 id="everyday-title" class="max-w-[16em] text-title-2 text-balance">
      {count} tools. Always one click away.
    </h2>
    <p class="mt-3 max-w-[34em] text-intro text-muted">
      Docked next to the Simulator, in your menu bar, or behind a global
      shortcut.
    </p>
  </div>
  <!-- Columns rather than a grid, so the groups pack by length. -->
  <div
    data-reveal
    class="mt-stack columns-2 gap-x-8 md:columns-3 lg:columns-4 lg:gap-x-10"
  >
    {
      sections.map(({ id, name, color, tools }) => (
        <div
          class="mb-9 break-inside-avoid border-t border-border pt-4"
          style={`--chapter: var(--color-chapter-${color})`}
        >
          <h3
            id={`everyday-${id}`}
            class="text-small font-semibold text-(--chapter)"
          >
            {name}
          </h3>
          <ul class="mt-3 space-y-1" aria-labelledby={`everyday-${id}`}>
            {tools.map(([tool, page]) => (
              <li>
                <a
                  href={`/features/${page}/`}
                  class="text-small text-text-dark no-underline lg:text-copy decoration-(--chapter) underline-offset-4 hover:underline"
                >
                  {tool}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="mt-6">
    <ArrowLink href="/features/">See all features</ArrowLink>
  </div>
</section>
